#!/usr/bin/env python3
"""
pre-commit: 守护共享 FeishuClient，拦截「绕过共享客户端直接调飞书」的提交。

只检查 claude-code/multi-file-refactor/ 目录下被暂存(staged)的 .py 文件。
命中以下任一模式即拒绝提交，并提示改走共享客户端 common.feishu.FeishuClient：

  1. 硬编码完整飞书 API URL，如 https://open.feishu.cn/open-apis/...
     （裸 endpoint 形如 "https://open.feishu.cn" 仅作配置默认值不算违规）
  2. 手动拼接 Bearer 鉴权头（鉴权应交给 FeishuClient 自动处理）
  3. 直接调用 /auth/v3/tenant_access_token/internal 自取 token
     （应使用 FeishuClient(app_id=..., app_secret=...)）
  4. 在 common/feishu 之外重复实现 post_json/post_multipart/get_json 等 HTTP 工具

白名单：common/feishu/ 目录是共享客户端实现本身，允许出现上述底层写法。

安装：在仓库根执行
  ln -s ../../claude-code/multi-file-refactor/common/git-hooks/pre-commit .git/hooks/pre-commit
"""

from __future__ import annotations

import re
import subprocess
import sys

TARGET_PREFIX = "claude-code/multi-file-refactor/"
# 白名单：共享基础设施目录，允许出现底层 URL / token / http 写法。
ALLOWED_PREFIXES = (
    TARGET_PREFIX + "common/feishu/",  # 共享客户端本体
    TARGET_PREFIX + "common/git-hooks/",  # 本 hook 自身等基础设施
)

# (正则, 仅限 .py, 违规说明, 修正建议)
BAD_PATTERNS = [
    (
        r"https?://open\.feishu\.cn/open-apis/",
        False,
        "硬编码了完整的飞书 API 地址",
        "改用 FeishuClient 的方法（如 client.bitable_list_tables），不要自己拼完整 URL",
    ),
    (
        # 只命中「拼接」动作：Bearer 后紧跟引号/花括号/加号（f-string、字符串拼接），
        # 避免误伤注释里单纯提到 Bearer 的文字。飞书 token 形如 t-xxx/u-xxx 单独再查一次。
        r"\bBearer\s[\"'{+]|Bearer\s+[tu]-[0-9a-zA-Z]",
        False,
        "手动拼接了 Bearer 鉴权头",
        "鉴权交给 FeishuClient 自动处理，不要自己拼 token / Authorization 头",
    ),
    (
        r"/open-apis/auth/v3/tenant_access_token/internal",
        False,
        "直接调用飞书 tenant_access_token 鉴权接口",
        "改用 FeishuClient(app_id=..., app_secret=...)，token 由共享客户端获取并缓存",
    ),
    (
        r"^\s*(?:async\s+)?def\s+(post_json|post_multipart|get_json|http_json_request)\b",
        True,
        "在共享客户端之外重复实现 HTTP 工具函数",
        "复用 common/feishu/http.py 里的 post_json / post_multipart / get_json",
    ),
]


def run_git(args: list[str]) -> str:
    result = subprocess.run(
        ["git", *args],
        capture_output=True,
        text=True,
        check=True,
    )
    return result.stdout


def staged_files() -> list[str]:
    out = run_git(["diff", "--cached", "--name-only", "--diff-filter=ACM"])
    return [line.strip() for line in out.splitlines() if line.strip()]


def staged_content(path: str) -> str:
    # 读取暂存区(index)里的内容，而非工作区，确保检查的就是即将提交的版本。
    result = subprocess.run(
        ["git", "show", f":{path}"],
        capture_output=True,
        text=True,
    )
    return result.stdout


def line_number_of(content: str, offset: int) -> int:
    return content.count("\n", 0, offset) + 1


def main() -> int:
    # 被检查的文件：在目标目录内、是 .py、且不在共享客户端白名单内。
    targets: list[str] = []
    for path in staged_files():
        if not path.startswith(TARGET_PREFIX):
            continue
        if any(path.startswith(prefix) for prefix in ALLOWED_PREFIXES):
            continue
        if not path.endswith(".py"):
            continue
        targets.append(path)

    violations: list[tuple[str, int, str, str, str]] = []
    for path in targets:
        content = staged_content(path)
        if not content:
            continue
        for pattern, py_only, message, hint in BAD_PATTERNS:
            if py_only and not path.endswith(".py"):
                continue
            for match in re.finditer(pattern, content, re.IGNORECASE | re.MULTILINE):
                violations.append(
                    (path, line_number_of(content, match.start()), match.group(0).strip(), message, hint)
                )

    if not violations:
        return 0

    bar = "=" * 72
    print(bar)
    print("❌ pre-commit 拦截：检测到「绕过共享 FeishuClient」的写法")
    print(bar)
    for path, lineno, matched, message, hint in violations:
        print(f"  {path}:{lineno}  → {message}")
        print(f"     命中: {matched!r}")
        print(f"     修正: {hint}")
        print()
    print("-" * 72)
    print("正确做法：使用共享客户端，鉴权与 URL 由它统一管理")
    print("    from common.feishu import FeishuClient")
    print('    client = FeishuClient(app_id=..., app_secret=...)   # 或 user_access_token=...')
    print("    client.bitable_list_tables(app_token)")
    print(bar)
    return 1


if __name__ == "__main__":
    sys.exit(main())
